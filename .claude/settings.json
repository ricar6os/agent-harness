{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/scripts/guard.py\"; [ -f \"$f\" ] || exit 0; exec python3 \"$f\" --agent claude"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/scripts/guard.py\"; [ -f \"$f\" ] || exit 0; exec python3 \"$f\" --agent claude"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/scripts/session-sync.sh\"; [ -f \"$f\" ] || exit 0; exec bash \"$f\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
